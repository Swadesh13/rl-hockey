{
    "train_env": {
        "n_envs": 16,
        "env_name": "HalfCheetah-v5",
        "weak_opponent": false
    },
    "agent": {
        "save_dir": "models/",
        "save": true
    },
    "model": {
        "name": "td7",
        "models_dir": "models/",
        "load": false,
        "model_load_name": "none",
        "hyperparameters": {
            "exploration_noise": {
                "type": "normal",
                "magnitude": 0.1
            },
            "alpha": 0.6,
            "buffer_size": 2000000,
            "learning_starts": 12500,
            "batch_size": 512,
            "discount": 0.99,
            "target_update_rate": 125,
            "target_policy_noise": 0.2,
            "policy_freq": 2,
            "noise_clip": 0.5,
            "learning_rate": 0.0003,
            "zs_dim": 256,
            "h_dim": 256,
            "device": "cuda",
            "seed": 42,
            "use_checkpoint": false,
            "steps_before_checkpointing": 10000,
            "max_eps_when_checkpointing": 20,
            "reset_weight": 0.9,
            "min_priority": 1,
            "sde_sample_freq": -1
        }
    },
    "training": {
        "total_timesteps": 250000,
        "save_model_every": 10000,
        "eval_starts": 10000,
        "eval_every": 10000,
        "model_path": "dummy not used for compatablity",
        "eval_episode_num": 20,
        "log_interval": 1000
    },
    "evaluation": {
        "ep_num": 20,
        "render_mode": "human"
    },
    "rnd": {
        "enabled": false
    }
}